{
  "name": "dsh-skin-android-boot",
  "version": "0.1.0",
  "description": "Detroit-inspired cold blue android boot skin for DeepSeek Harness Web: split-ring brand mark and a cool industrial light/dark palette.",
  "license": "MIT",
  "type": "module",
  "keywords": ["dsh", "dsh-plugin", "dsh-skin", "theme"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "screenshots/*.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}